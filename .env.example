# ======================================================================
# 3D Apparel Marketplace & WebGL Customizer Studio
# Environment Configuration Template (.env.example)
# ======================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/marketplace

# Store Metadata
STORE_NAME="3D Apparel Marketplace"
STORE_WHATSAPP="6281234567890"

# Default Administrator Credentials (Initial Seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database Configuration (Defaults to SQLite zero-config in data/marketplace.db)
DB_CONNECTION=sqlite
DB_DATABASE=data/marketplace.db
